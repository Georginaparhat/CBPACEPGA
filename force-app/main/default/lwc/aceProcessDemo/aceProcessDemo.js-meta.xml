<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>ACE PGA process demo</masterLabel>
    <description>Stakeholder demo of the ACE PGA User Experience Process Map: one view per actor (requester, supervisor, CBP supervisor, vetting, security, provisioning, overview).</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightningCommunity__Default">
            <property name="persona" type="String" label="Persona" default="requester" datasource="requester,supervisor,cbpSupervisor,vetting,security,provisioning,overview" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>