<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>CBP PGA Application Home 2</masterLabel>
    <description>Applicant checklist and forms for Experience Cloud only.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="packageRecordId" type="String" label="PGA Package Record Id" />
            <property name="request7300RecordId" type="String" label="Form 7300 Record Id" />
            <property name="aceAccessInScope" type="Boolean" label="ACE access in scope" default="false" />
            <property name="autoInitialize" type="Boolean" label="Auto-create draft 7300 on load" default="false" />
            <property name="initialFormStep" type="String" label="Initial checklist step (form004, form001, …)" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>