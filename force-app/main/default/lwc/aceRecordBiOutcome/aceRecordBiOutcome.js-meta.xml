<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>ACE Record BI Outcome</masterLabel>
    <description>Vetting: record the background investigation (BI) outcome on an ACE PGA Application Package or a Form 7300 Request.</description>
    <targets>
        <target>lightning__RecordAction</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordAction">
            <actionType>ScreenAction</actionType>
        </targetConfig>
        <targetConfig targets="lightning__RecordPage">
            <property name="variant" type="String" label="Display" default="panel" datasource="panel,action" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>